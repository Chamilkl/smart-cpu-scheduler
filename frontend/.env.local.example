# ====================================================================
# Smart CPU Scheduler – Environment Configuration
# ====================================================================

# Backend CPU Simulation API (Render or Local)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key MUST NOT be prefixed with NEXT_PUBLIC_ (Server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Dashboard Protection
# Set a strong password/passphrase for /admin dashboard access
ADMIN_PASSWORD=admin_cpu_scheduler_2026
ADMIN_SESSION_SECRET=super-secret-key-change-in-production-min32chars
